generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AUDITOR
}

enum AuditStatus {
  SCHEDULED
  IN_PROGRESS
  PAUSED
  DRAFT
  COMPLETED
  CANCELLED
}

enum ItemResult {
  PASS
  FAIL
  NA
}

enum CAPStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime? @map("email_verified")
  image          String?
  password       String
  role           Role      @default(AUDITOR)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  audits        Audit[]      @relation("AuditorAudits")
  changeHistory ChangeHistory[]

  @@map("users")
}

model Factory {
  id          String   @id @default(cuid())
  name        String
  vendorName  String?  @map("vendor_name")
  address     String?
  city        String?
  country     String?
  contactName String?  @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  audits Audit[]

  @@map("factories")
}

model AuditTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sections TemplateSection[]
  audits   Audit[]

  @@map("audit_templates")
}

model TemplateSection {
  id          String   @id @default(cuid())
  templateId  String   @map("template_id")
  title       String
  sortOrder   Int      @default(0) @map("sort_order")
  maxScore    Float?   @map("max_score")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  template AuditTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ChecklistItem[]

  @@map("template_sections")
}

model ChecklistItem {
  id          String   @id @default(cuid())
  sectionId   String   @map("section_id")
  text        String
  maxScore    Float    @default(5) @map("max_score")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  section       TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  auditResults  AuditItemResult[]

  @@map("checklist_items")
}

model Audit {
  id            String      @id @default(cuid())
  status        AuditStatus @default(SCHEDULED)
  factoryId     String      @map("factory_id")
  templateId    String      @map("template_id")
  auditorId     String      @map("auditor_id")
  scheduledAt   DateTime?   @map("scheduled_at")
  startTime     DateTime?   @map("start_time")
  endTime       DateTime?   @map("end_time")
  totalDuration Int         @default(0) @map("total_duration")
  lastResumedAt DateTime?   @map("last_resumed_at")
  overallScore  Float?      @map("overall_score")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  factory       Factory          @relation(fields: [factoryId], references: [id])
  template      AuditTemplate    @relation(fields: [templateId], references: [id])
  auditor       User             @relation("AuditorAudits", fields: [auditorId], references: [id])
  sections      AuditSection[]
  itemResults   AuditItemResult[]
  gpsLogs       GPSLog[]
  photos        Photo[]
  caps          CAP[]

  @@map("audits")
}

model AuditSection {
  id          String   @id @default(cuid())
  auditId     String   @map("audit_id")
  title       String
  sortOrder   Int      @default(0) @map("sort_order")
  score       Float?
  maxScore    Float?   @map("max_score")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  audit Audit            @relation(fields: [auditId], references: [id], onDelete: Cascade)
  items AuditItemResult[]

  @@map("audit_sections")
}

model AuditItemResult {
  id          String      @id @default(cuid())
  auditId     String      @map("audit_id")
  sectionId   String      @map("section_id")
  itemId      String      @map("item_id")
  result      ItemResult?
  score       Float?
  findings    String?
  remarks     String?
  requiresCap Boolean     @default(false) @map("requires_cap")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  audit   Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  section AuditSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  item    ChecklistItem @relation(fields: [itemId], references: [id])
  photos  Photo[]
  cap     CAP?

  @@unique([auditId, itemId])
  @@map("audit_item_results")
}

model Photo {
  id               String  @id @default(cuid())
  auditId          String  @map("audit_id")
  itemResultId     String? @map("item_result_id")
  cloudStoragePath String  @map("cloud_storage_path")
  caption          String?
  isPublic         Boolean @default(false) @map("is_public")
  createdAt        DateTime @default(now()) @map("created_at")

  audit      Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemResult AuditItemResult? @relation(fields: [itemResultId], references: [id], onDelete: SetNull)

  @@map("photos")
}

model CAP {
  id          String    @id @default(cuid())
  auditId     String    @map("audit_id")
  itemResultId String   @unique @map("item_result_id")
  finding     String    @db.Text
  correctiveAction String? @db.Text @map("corrective_action")
  status      CAPStatus @default(OPEN)
  targetDate  DateTime? @map("target_date")
  planDate    DateTime? @map("plan_date")
  actionDate  DateTime? @map("action_date")
  verifiedBy  String?   @map("verified_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  audit       Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemResult  AuditItemResult @relation(fields: [itemResultId], references: [id])
  attachments CAPAttachment[]

  @@map("caps")
}

model CAPAttachment {
  id               String   @id @default(cuid())
  capId            String   @map("cap_id")
  cloudStoragePath String   @map("cloud_storage_path")
  fileName         String   @map("file_name")
  mimeType         String?  @map("mime_type")
  createdAt        DateTime @default(now()) @map("created_at")

  cap CAP @relation(fields: [capId], references: [id], onDelete: Cascade)

  @@map("cap_attachments")
}

model GPSLog {
  id        String   @id @default(cuid())
  auditId   String   @map("audit_id")
  latitude  Float
  longitude Float
  accuracy  Float?
  loggedAt  DateTime @default(now()) @map("logged_at")

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("gps_logs")
}

model ChangeHistory {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  changes    Json?
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("change_history")
}
